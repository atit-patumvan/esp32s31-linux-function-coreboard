#!/bin/sh

PIDFILE=/run/ntpd.pid

start() {
	printf 'Starting ntpd: '
	if [ -s "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
		echo 'already running'
		return 0
	fi

	(
		tries=0
		while ! ip route 2>/dev/null | grep -q '^default '; do
			tries=$((tries + 1))
			[ "$tries" -ge 30 ] && exit 1
			sleep 1
		done
		exec ntpd -n -p 0.pool.ntp.org -p 1.pool.ntp.org
	) &
	echo $! > "$PIDFILE"
	echo 'OK'
}

stop() {
	printf 'Stopping ntpd: '
	if [ -s "$PIDFILE" ]; then
		kill "$(cat "$PIDFILE")" 2>/dev/null || true
		rm -f "$PIDFILE"
	fi
	echo 'OK'
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
